FLASK_APP=wsgi.py
FLASK_RUN_PORT=5001
FLASK_DEBUG=1
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_JWT_EXPIRES_SECONDS=43200
DATABASE_URL=sqlite:///mamanbaba.db
DATABASE_AUTO_UPGRADE=true
CORS_ORIGINS=https://app.mamanbaba.com,http://localhost:5173,http://127.0.0.1:5173,https://localhost:5173,https://127.0.0.1:5173
CORS_ALLOW_LOCALHOST=true
OTP_PROVIDER=static
OTP_STATIC_CODE=12345
OTP_TTL_SECONDS=120
OTP_LENGTH=5
OTP_DEBUG_RESPONSE=false
KAVENEGAR_API_KEY=
KAVENEGAR_VERIFY_TEMPLATE=
KAVENEGAR_VERIFY_TYPE=sms
KAVENEGAR_USE_CURL_FALLBACK=1
KAVENEGAR_REQUEST_TIMEOUT_SECONDS=10
UPLOAD_FOLDER=uploads
